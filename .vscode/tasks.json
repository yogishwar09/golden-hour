{
  "version": "2.0.0",
  "tasks": [
    {
      // The default build task: Ctrl+Shift+B / Cmd+Shift+B.
      "label": "dev: API + web",
      "type": "shell",
      "command": "npm run dev",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): (error|warning) TS(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        // Lets VS Code know when the servers are up rather than waiting forever.
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(vite|tsx).*",
          "endsPattern": ".*(ready in|listening on).*"
        }
      }
    },
    {
      "label": "web only",
      "type": "shell",
      "command": "npm run dev:frontend",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "seed the database",
      "type": "shell",
      "command": "npm run seed",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "run the fleet simulator",
      "type": "shell",
      "command": "npm run simulate",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "npm test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "build everything",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
