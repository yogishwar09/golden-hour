# ---------------------------------------------------------------------------
# Backend configuration.
# Copy to backend/.env and edit. Every value here has a working default except
# in production, where JWT_SECRET and MONGO_URI must be set explicitly.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database --------------------------------------------------------------
# Leave MONGO_URI unset in development: the server starts and manages a local
# MongoDB for you, storing data in backend/.local-db.
# For MongoDB Atlas, use the connection string from your cluster:
#   MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGO_URI=
MONGO_DB_NAME=smart_ambulance

# --- Authentication --------------------------------------------------------
# MUST be changed for production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production
JWT_TTL_SECONDS=43200

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# In production this is your deployed front end, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Routing ---------------------------------------------------------------
# The public OSRM demo server is rate-limited and offers no uptime guarantee.
# Run your own (https://github.com/Project-OSRM/osrm-backend) for production.
# With ROUTING_ENABLED=false the system falls back to straight-line estimates
# and keeps working, just with less accurate ETAs.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_ENABLED=true
ROUTING_TIMEOUT_MS=4000

# --- Dispatch tuning -------------------------------------------------------
# How long a crew has to accept an offer before it passes to the next crew.
DISPATCH_OFFER_TIMEOUT_SECONDS=25
# First-pass search radius, then the widened sweep if nothing is found.
DISPATCH_SEARCH_RADIUS_KM=15
DISPATCH_MAX_RADIUS_KM=40
# Vehicles to try before declaring no ambulance available.
DISPATCH_MAX_CANDIDATES=5

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Emergency requests per account per 10 minutes.
SOS_RATE_LIMIT_MAX=6
# Sign-in attempts per IP per 15 minutes. Keep this tight in a real deployment;
# raise it only where a simulated fleet signs in many crews from one address.
AUTH_RATE_LIMIT_MAX=20

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=info
# Password given to every account created by `npm run seed`.
SEED_PASSWORD=Password123

# ---------------------------------------------------------------------------
# Frontend configuration (copy to frontend/.env).
# Leave unset in development: Vite proxies /api and /socket.io to the backend.
# In production, set it to your deployed API origin.
# ---------------------------------------------------------------------------
# VITE_API_URL=https://your-api.onrender.com
